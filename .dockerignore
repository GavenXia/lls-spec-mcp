# =============================================================================
# Docker Ignore File - 优化镜像构建
# =============================================================================
# 排除不需要打包到 Docker 镜像中的文件和目录
# =============================================================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs (会在容器中重新构建)
dist/
build/
*.tsbuildinfo

# Development files
src/**/*.test.ts
src/**/*.spec.ts
**/__tests__/
**/__mocks__/
.vscode/
.idea/

# Git
.git/
.gitignore
.gitattributes

# Documentation (除了 README 和 LICENSE)
docs/
*.md
!README.md
!LICENSE

# Testing
coverage/
.nyc_output/
vitest.config.ts

# Environment files
.env
.env.*
!.env.example

# Spec-workflow 工作目录
.spec-workflow/
origin-requirements/

# Temporary files
*.tmp
*.temp
.tmp/
.temp/
*.log

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Docker files (不需要在镜像中)
Dockerfile*
docker-compose*.yml
.dockerignore

# VSCode extension
vscode-extension/

# Scripts - 保留构建脚本
# scripts/  # 需要用于构建，不能排除

# Package lock files (使用 package-lock.json 即可)
yarn.lock
pnpm-lock.yaml

# TypeScript config - 保留用于构建
# tsconfig.json  # 需要用于 TypeScript 编译，不能排除

# Editor configs
.editorconfig
.prettierrc
.prettierignore
.eslintrc*
.eslintignore

# Other
*.pdf
*.zip
*.tar.gz
*.rar

