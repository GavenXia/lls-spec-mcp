{
  "mcpServers": {
    "spec-workflow": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-v",
        "${workspaceFolder}/.spec-workflow:${workspaceFolder}/.spec-workflow:rw",
        "--entrypoint=node",
        "gavinxia/spec-workflow-mcp:latest",
        "/app/dist/index.js",
        "${workspaceFolder}"
      ]
    }
  }
}
